<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.MyGVP" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primaryDark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary colors -->
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Background -->
        <item name="android:windowBackground">@color/background</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>

        <!-- Components -->
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.MyGVP.Large</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.MyGVP.Medium</item>
    </style>

    <style name="ShapeAppearance.MyGVP.Large" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerSize">32dp</item>
    </style>

    <style name="ShapeAppearance.MyGVP.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">24dp</item>
    </style>

    <style name="BottomSheetDialogTheme" parent="Theme.MaterialComponents.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetStyle</item>
    </style>

    <style name="BottomSheetStyle" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

</resources>