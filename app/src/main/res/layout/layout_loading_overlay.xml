<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/loadingOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6FFFFFF"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="320dp"
        android:layout_height="240dp"
        app:cardCornerRadius="36dp"
        app:cardElevation="0dp"
        app:strokeWidth="2dp"
        app:strokeColor="#F5F5F5"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvLoadingTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="GVP COLLEGE BUS"
                android:textColor="@color/univ_primary"
                android:textSize="18sp"
                android:letterSpacing="0.1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- The Road (Black) -->
            <View
                android:id="@+id/roadLine"
                android:layout_width="240dp"
                android:layout_height="4dp"
                android:layout_marginBottom="70dp"
                android:background="#000000"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- The Bus Image (Using your PNG) -->
            <ImageView
                android:id="@+id/ivBus"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_bus"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toTopOf="@id/roadLine"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="@id/roadLine"
                app:layout_constraintEnd_toEndOf="@id/roadLine"
                android:layout_marginBottom="-12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="Syncing your GVP dashboard..."
                android:textColor="#757575"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
